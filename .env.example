# Docker Compose deployment. Copy to .env locally; never commit the filled file.
RUNTIME_ENVIRONMENT=production
# Generate an independent random secret (at least 32 characters).
SECRET_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
# Set only for initial administrator creation; at least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_DEVICES=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MOCK=false
