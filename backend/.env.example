# Local development only. Copy to backend/.env and run from backend/.
RUNTIME_ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/industrial_diagnosis.db
MQTT_HOST=localhost
MQTT_PORT=1883
SEED_DEMO_DEVICES=true
# Without a configured SECRET_KEY, development tokens expire on process restart.
# SECRET_KEY=
# Local development retains the documented demo seed. Set a private password
# here for a new database, or use the normal account-management workflow.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MOCK=false
